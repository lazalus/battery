# Kakao Maps (JavaScript Key)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY
NEXT_PUBLIC_SITE_URL=https://batteryfit.example.com
SITE_URL=https://batteryfit.example.com
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_BRAND_HUB_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BRAND_HUB_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_MODEL_LANDING_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MODEL_LANDING_INLINE=
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Database: Cloudflare D1 (configured via wrangler.jsonc binding "DB")

# Gemini (Server-side)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Coupang Partners (Server-side)
COUPANG_ACCESS_KEY=YOUR_COUPANG_ACCESS_KEY
COUPANG_SECRET_KEY=YOUR_COUPANG_SECRET_KEY
COUPANG_PARTNERS_ID=YOUR_COUPANG_PARTNERS_ID
COUPANG_PARTNERS_SUB_ID=YOUR_SUB_ID
COUPANG_USE_PARTNERS_REDIRECT=false
# Optional template placeholders: {PARTNERS_ID} {QUERY} {ENCODED_QUERY} {TARGET_URL} {ENCODED_TARGET_URL} {SUB_ID}
# Example: https://link.coupang.com/a/{PARTNERS_ID}?subId={SUB_ID}&url={ENCODED_TARGET_URL}
COUPANG_PARTNERS_LINK_TEMPLATE=
COUPANG_SEARCH_BASE_URL=https://www.coupang.com/np/search

# Admin (token-based)
ADMIN_TOKEN=zx917az1-Z
