generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

model VehicleBrand {
  id        String         @id @default(cuid())
  sourceId  Int            @unique
  name      String
  origin    String
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model VehicleModel {
  id        String        @id @default(cuid())
  sourceId  Int           @unique
  name      String
  brandId   String
  brand     VehicleBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  trims     VehicleTrim[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([brandId])
}

model VehicleTrim {
  id         String           @id @default(cuid())
  sourceId   Int              @unique
  name       String
  yearLabel  String?
  engineLabel String?
  modelId    String
  model      VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fitments   BatteryFitment[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([modelId])
}

model BatteryFitment {
  id          String      @id @default(cuid())
  trimId      String
  trim        VehicleTrim @relation(fields: [trimId], references: [id], onDelete: Cascade)
  brand       String
  productCode String?
  productName String
  spec        String?
  source      String
  sourceUrl   String?
  isPrimary   Boolean     @default(false)
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([trimId])
}

model BatteryNotePost {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String
  content      String
  thumbnailUrl String
  bodyImageUrls Json?
  tags         Json?
  status       String   @default("DRAFT")
  reviewedAt   DateTime?
  reviewerId   String?
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
  @@index([status, publishedAt])
}

model AppUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
